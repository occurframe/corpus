{
  "$id": "https://occurframe.dev/schemas/1/vector-id-registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "corpus_version": { "const": "1.0.0-rc2" },
    "ids": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "family": { "type": "string" },
          "id": { "type": "string" },
          "status": { "enum": ["active", "retired"] },
          "superseded_by": { "type": "string" }
        },
        "required": ["id", "family", "status"],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": { "const": "1.0.0" }
  },
  "required": ["schema_version", "corpus_version", "ids"],
  "title": "Occurframe stable vector ID registry",
  "type": "object"
}
