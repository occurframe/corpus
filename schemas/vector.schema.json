{
  "$id": "https://occurframe.dev/schemas/1/vector.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "classification": {
      "enum": [
        "NORMATIVE",
        "POLICY_DEPENDENT",
        "DIALECT_DEPENDENT",
        "AMBIGUOUS_STANDARD",
        "KNOWN_DIVERGENCE",
        "INVALID"
      ]
    },
    "context": { "type": "object" },
    "corpus_version": { "const": "1.0.0-rc2" },
    "expectation": { "$ref": "#/$defs/expectation" },
    "family": { "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "type": "string" },
    "id": { "pattern": "^(?:(?:CRON|RRULE)-[A-Z0-9-]+-[0-9]{3}|TZDB-[0-9]{3})$", "type": "string" },
    "input": { "type": "object" },
    "kind": { "enum": ["cron", "rrule"] },
    "lifecycle": { "enum": ["active", "retired"] },
    "normative_evidence": {
      "items": { "$ref": "#/$defs/evidence" },
      "type": "array"
    },
    "operation": {
      "enum": ["cron.next", "cron.parse", "rrule.expand", "rrule.parse", "rrule.between"]
    },
    "rationale": { "minLength": 1, "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "semantic_axes": {
      "items": { "pattern": "^[a-z][a-z0-9_]*(?:[.][a-zA-Z0-9_]+)+$", "type": "string" },
      "type": "array",
      "uniqueItems": true
    },
    "supersession": { "$ref": "#/$defs/supersession" },
    "tags": { "items": { "type": "string" }, "type": "array" },
    "title": { "minLength": 1, "type": "string" }
  },
  "required": [
    "schema_version",
    "corpus_version",
    "id",
    "family",
    "title",
    "kind",
    "operation",
    "input",
    "context",
    "classification",
    "semantic_axes",
    "normative_evidence",
    "expectation",
    "rationale",
    "tags",
    "lifecycle"
  ],
  "title": "Occurframe authored conformance vector",
  "type": "object",
  "$defs": {
    "case": {
      "additionalProperties": false,
      "properties": {
        "label": { "minLength": 1, "type": "string" },
        "note": { "type": "string" },
        "occurrences": {
          "oneOf": [
            { "items": { "type": "string" }, "type": "array" },
            { "type": "null" }
          ]
        },
        "when": {
          "additionalProperties": { "$ref": "#/$defs/semantic_value" },
          "type": "object"
        }
      },
      "required": ["label", "when", "occurrences"],
      "type": "object"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "note": { "type": "string" },
        "quote": { "type": "string" },
        "source_id": { "minLength": 1, "type": "string" }
      },
      "required": ["source_id"],
      "type": "object"
    },
    "expectation": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "single" },
            "note": { "type": "string" },
            "occurrences": { "items": { "type": "string" }, "type": "array" }
          },
          "required": ["mode", "occurrences"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "error_class": { "type": "string" },
            "mode": { "const": "reject" },
            "note": { "type": "string" }
          },
          "required": ["mode"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "cases": { "items": { "$ref": "#/$defs/case" }, "minItems": 1, "type": "array" },
            "mode": { "enum": ["per_policy", "per_dialect", "admissible"] },
            "note": { "type": "string" }
          },
          "required": ["mode", "cases"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "open" },
            "note": { "type": "string" }
          },
          "required": ["mode"],
          "type": "object"
        }
      ]
    },
    "supersession": {
      "additionalProperties": false,
      "anyOf": [
        { "required": ["supersedes"] },
        { "required": ["superseded_by"] }
      ],
      "properties": {
        "reason": { "minLength": 1, "type": "string" },
        "superseded_by": { "type": "string" },
        "supersedes": { "type": "string" }
      },
      "required": ["reason"],
      "type": "object"
    },
    "semantic_value": {
      "oneOf": [
        { "type": "string" },
        { "type": "integer" },
        { "type": "boolean" }
      ]
    }
  }
}
