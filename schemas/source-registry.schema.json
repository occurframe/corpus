{
  "$id": "https://occurframe.dev/schemas/1/source-registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "source_id": { "minLength": 1, "type": "string" },
          "title": { "minLength": 1, "type": "string" },
          "url": { "format": "uri", "type": "string" }
        },
        "required": ["source_id", "title", "url"],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": ["schema_version", "sources"],
  "title": "Occurframe normative source registry",
  "type": "object"
}
