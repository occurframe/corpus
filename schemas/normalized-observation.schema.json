{
  "$id": "https://occurframe.dev/schemas/1/normalized-observation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "corpus_version": { "type": "string" },
    "dialect_ids": { "items": { "type": "string" }, "type": "array" },
    "engine": { "$ref": "#/$defs/component" },
    "engine_outcome": { "$ref": "#/$defs/outcome" },
    "execution_status": { "enum": ["completed", "timeout", "runner_failure"] },
    "protocol_version": { "const": "3.0" },
    "runner_environment": { "$ref": "#/$defs/runner_environment" },
    "runner": { "$ref": "#/$defs/component" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "semantic_profile_claims": {
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "integer" },
          { "type": "boolean" }
        ]
      },
      "type": "object"
    },
    "tzdb_provenance": { "$ref": "#/$defs/tzdb" },
    "vector_id": { "type": "string" },
    "warnings": { "items": { "$ref": "#/$defs/diagnostic" }, "type": "array" }
  },
  "required": [
    "protocol_version",
    "corpus_version",
    "vector_id",
    "runner",
    "engine",
    "runtime",
    "dialect_ids",
    "semantic_profile_claims",
    "tzdb_provenance",
    "runner_environment",
    "execution_status",
    "warnings"
  ],
  "title": "Occurframe normalized observation",
  "type": "object",
  "$defs": {
    "component": {
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "provenance": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["name", "version"],
      "type": "object"
    },
    "diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "details": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["code", "message"],
      "type": "object"
    },
    "outcome": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "occurrences": { "items": { "type": "string" }, "type": "array" },
            "type": { "const": "occurrences" }
          },
          "required": ["type", "occurrences"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": { "type": { "const": "accepted" } },
          "required": ["type"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "diagnostic": { "$ref": "#/$defs/diagnostic" },
            "type": { "enum": ["rejection", "unsupported", "engine_error"] }
          },
          "required": ["type", "diagnostic"],
          "type": "object"
        }
      ]
    },
    "runtime": {
      "additionalProperties": false,
      "properties": {
        "language": { "type": "string" },
        "runtime": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["language", "runtime", "version"],
      "type": "object"
    },
    "runner_environment": {
      "additionalProperties": false,
      "properties": {
        "environment_policy": { "const": "hermetic_allowlist_v1" },
        "explicit_runner_variable_names": {
          "items": { "type": "string" },
          "type": "array"
        },
        "host_timezone_setting": { "type": "string" },
        "launch_resolution_method": {
          "enum": ["absolute_path", "repository_relative", "search_path"]
        },
        "locale_policy": { "type": "string" },
        "platform_variable_names": {
          "items": { "type": "string" },
          "type": "array"
        }
      },
      "required": [
        "environment_policy",
        "host_timezone_setting",
        "locale_policy",
        "launch_resolution_method",
        "platform_variable_names",
        "explicit_runner_variable_names"
      ],
      "type": "object"
    },
    "tzdb": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "fingerprint": { "type": "string" },
            "release": { "type": "string" },
            "release_kind": { "const": "exact" },
            "source": { "type": "string" }
          },
          "required": ["source", "release_kind", "release"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "fingerprint": { "type": "string" },
            "max_inclusive": { "type": "string" },
            "min_inclusive": { "type": "string" },
            "release_kind": { "const": "bounded" },
            "source": { "type": "string" }
          },
          "required": ["source", "release_kind"],
          "anyOf": [
            { "required": ["min_inclusive"] },
            { "required": ["max_inclusive"] }
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "fingerprint": { "type": "string" },
            "release_kind": { "const": "unknown" },
            "source": { "type": "string" }
          },
          "required": ["source", "release_kind"],
          "type": "object"
        }
      ]
    }
  }
}
